NODE_ENV=development
APP_URL=http://localhost:3000
# Set this to the exact origin used by the app when it differs from APP_URL.
BETTER_AUTH_URL=

# Local development only: "mock" simulates; "provider-dev" uses configured provider keys.
# Both modes are disabled in production.
AI_PROVIDER_MODE=mock

# Production database; migrations are included but cannot run without a reachable PostgreSQL server.
DATABASE_URL=

# Google sign-in uses the OAuth callback {BETTER_AUTH_URL or APP_URL}/api/auth/callback/google.
# Register the exact callback URI in Google Cloud Console. These values stay server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Planned payment integrations.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Direct provider development mode reads these server-side keys and sends prompts
# to the selected provider. Provider accounts are billed directly; no TZC charge
# or durable usage record is created. Keep AI_PROVIDER_MODE=mock by default.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBSERVABILITY_DSN=
