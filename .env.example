NODE_ENV=development
APP_URL=http://localhost:3000

# Set to "mock" only for local development. The mock gateway is disabled in production.
AI_PROVIDER_MODE=mock

# Production database; migrations are included but cannot run without a reachable PostgreSQL server.
DATABASE_URL=

# Planned integrations. These are intentionally not read by the demo app yet.
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBSERVABILITY_DSN=
